{"css": "<style>@page { size: A4; }\n:root { --ink: #141b2b; --muted: #5b6475; --dim: #8a94a6; --rule: #dfe4ec; --soft: #f5f7fa; --red: #c62828; --amber: #b07114; --green: #2e7d32; --blue: #1f5fbf; --orange: #d0661f; }\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: #fff; color: var(--ink); font-family: Inter, sans-serif; font-size: 9pt; line-height: 1.45; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n.page + .page { break-before: page; padding-top: 1px; }\n.mono, .lab, .kicker, .tag, .meta span, .when, .ph, .k { font-family: \"JetBrains Mono\", monospace; }\n.lab { font-size: 6.6pt; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); margin-bottom: 4pt; }\n.small { font-size: 7pt; }\n.muted { color: var(--muted); } .red { color: var(--red); } .amber { color: var(--amber); } .green { color: var(--green); } .blue { color: var(--blue); } .orange { color: var(--orange); }\n.tag { display: inline-block; font-size: 6.4pt; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border: 1px solid currentColor; border-radius: 3pt; padding: 1pt 4pt; white-space: nowrap; line-height: 1.3; }\nh2 { font-size: 12pt; margin: 0 0 6pt; padding-left: 7pt; border-left: 3pt solid var(--amber); line-height: 1.2; display: flex; align-items: baseline; gap: 10pt; }\nh2 .note { font-weight: 400; font-size: 7.5pt; color: var(--dim); }\n.mt { margin-top: 10pt; } .mt2 { margin-top: 9pt; }\nstrong { font-weight: 700; color: var(--ink); }\n\n.top { display: grid; gap: 8pt; border-bottom: 2pt solid var(--ink); padding-bottom: 7pt; margin-bottom: 10pt; }\n.kicker { font-size: 6.8pt; letter-spacing: .16em; text-transform: uppercase; color: var(--amber); font-weight: 700; }\nh1 { font-size: 22pt; margin: 2pt 0 0; letter-spacing: -.01em; line-height: 1.1; }\n.meta { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 2pt 26pt; }\n.meta div { display: grid; }\n.meta span { font-size: 6pt; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }\n.meta b { font-size: 8pt; font-family: \"JetBrains Mono\", monospace; font-weight: 600; white-space: nowrap; }\n\n.hero { display: grid; grid-template-columns: 1fr 1.25fr; gap: 14pt; }\n.verdict { background: var(--soft); border: 1px solid var(--rule); border-radius: 6pt; padding: 10pt 12pt; }\n.big { font-size: 34pt; font-weight: 800; letter-spacing: .01em; text-transform: uppercase; line-height: 1; margin: 2pt 0 7pt; }\n.segs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4pt; margin-bottom: 7pt; }\n.seg i { display: block; height: 5pt; border-radius: 3pt; background: #dfe4ec; }\n.seg span { font-family: \"JetBrains Mono\", monospace; font-size: 6pt; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }\n.seg.on.amber i { background: var(--amber); } .seg.on.red i { background: var(--red); } .seg.on.green i { background: var(--green); }\n.seg.on span { color: var(--ink); font-weight: 700; }\n.prev { font-family: \"JetBrains Mono\", monospace; font-size: 7pt; color: var(--muted); margin-bottom: 7pt; }\n.lede { margin: 0; font-size: 9.4pt; line-height: 1.5; }\n.fronts table { width: 100%; border-collapse: collapse; }\n.fronts td { padding: 4pt 0 0; vertical-align: middle; }\n.fronts td.fn { font-weight: 700; font-size: 8.8pt; }\n.fronts td:nth-child(2) { width: 1%; padding-right: 8pt; }\n.fronts td:nth-child(3) { width: 1%; white-space: nowrap; text-align: right; color: var(--muted); }\n.fronts tr.sub td { padding: 1pt 0 4pt; border-bottom: 1px solid var(--rule); color: var(--muted); font-size: 7.5pt; line-height: 1.35; }\n\n.kpis { display: grid; grid-template-columns: repeat(7, 1fr); border: 1px solid var(--rule); border-radius: 6pt; margin-top: 10pt; }\n.kpi { padding: 7pt 8pt; border-left: 1px solid var(--rule); }\n.kpi:first-child { border-left: 0; }\n.kpi .lab { font-size: 5.6pt; letter-spacing: .08em; margin-bottom: 2pt; min-height: 13pt; }\n.kpi .v { font-family: \"JetBrains Mono\", monospace; font-size: 15pt; font-weight: 700; line-height: 1.1; }\n.kpi .s { font-size: 6.6pt; color: var(--muted); line-height: 1.3; margin-top: 2pt; }\n.vig { margin-top: 10pt; border-left: 3pt solid var(--amber); background: var(--soft); padding: 8pt 11pt; border-radius: 0 6pt 6pt 0; }\n.vig ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4pt 16pt; }\n.vig li { display: grid; grid-template-columns: 62pt 1fr; gap: 6pt; font-size: 8.8pt; line-height: 1.35; }\n.when { font-size: 6.4pt; letter-spacing: .08em; text-transform: uppercase; color: var(--amber); font-weight: 700; padding-top: 1pt; }\n\n.cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9pt; }\n.col { border: 1px solid var(--rule); border-top: 2.5pt solid var(--c); border-radius: 5pt; padding: 7pt 8pt; }\n.col[data-c=red], .scen[data-c=red] { --c: var(--red); } .col[data-c=blue] { --c: var(--blue); } .col[data-c=amber], .scen[data-c=amber] { --c: var(--amber); } .scen[data-c=orange] { --c: var(--orange); }\n.col h3 { font-size: 8.8pt; margin: 0 0 4pt; display: flex; justify-content: space-between; gap: 6pt; color: var(--ink); }\n.col h3 span { font-family: \"JetBrains Mono\", monospace; font-weight: 400; font-size: 6.4pt; color: var(--dim); white-space: nowrap; }\n.fact { padding: 5pt 0; border-top: 1px solid var(--rule); break-inside: avoid; }\n.fact:first-of-type { border-top: 0; }\n.ft { display: flex; justify-content: space-between; align-items: center; gap: 6pt; font-size: 7pt; color: var(--muted); margin-bottom: 2pt; }\n.fact b { font-size: 8.4pt; line-height: 1.3; display: block; }\n.fact p { margin: 1.5pt 0; font-size: 7.1pt; line-height: 1.33; color: #333c4d; }\n.src { font-size: 6.6pt; color: var(--dim); }\n.synth p { margin: 0 0 2pt; text-align: justify; hyphens: auto; font-size: 7.9pt; line-height: 1.36; color: #263042; }\n.ph { font-size: 6.6pt; letter-spacing: .1em; text-transform: uppercase; color: var(--amber); font-weight: 700; margin-right: 5pt; }\n\n.scens { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9pt; }\n.scen { border: 1px solid var(--rule); border-top: 2.5pt solid var(--c); border-radius: 5pt; padding: 7pt 9pt; break-inside: avoid; }\n.scen h4 { margin: 4pt 0 3pt; font-size: 9.4pt; line-height: 1.25; }\n.scen p { margin: 0 0 3pt; font-size: 7.4pt; line-height: 1.38; color: #333c4d; }\n.k { font-size: 5.8pt; letter-spacing: .12em; text-transform: uppercase; color: var(--dim); margin-top: 3pt; }\n.scen ul { margin: 1pt 0 0; padding-left: 10pt; font-size: 7.3pt; line-height: 1.35; color: var(--muted); }\n.sit { display: grid; grid-template-columns: .9fr 1.1fr; gap: 12pt; align-items: start; }\n.map svg { border: 1px solid var(--rule); border-radius: 5pt; display: block; }\n.legend { display: flex; flex-wrap: wrap; gap: 2pt 9pt; font-size: 6.4pt; color: var(--muted); margin-top: 4pt; }\n.legend span { display: inline-flex; align-items: center; gap: 3pt; }\ntable.mini { width: 100%; border-collapse: collapse; font-size: 7.2pt; }\ntable.mini td { padding: 1.8pt 0; border-top: 1px solid var(--rule); vertical-align: top; line-height: 1.3; }\ntable.mini td:last-child { text-align: right; width: 1%; padding-left: 6pt; }\ntable.mini .muted { font-size: 6.4pt; }\n.foot { margin-top: 7pt; font-size: 6.6pt; color: var(--dim); line-height: 1.4; border-top: 1px solid var(--rule); padding-top: 5pt; }\n.airg { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 10pt; font-size: 6.8pt; }\n.ai { display: flex; justify-content: space-between; align-items: center; gap: 4pt; border-top: 1px solid var(--rule); padding: 2pt 0; line-height: 1.25; }\n.ai .tag { font-size: 5.6pt; padding: .5pt 3pt; }\n.ai .muted { font-size: 6pt; }\n.scen ul { font-size: 6.9pt; line-height: 1.3; }\n.sit { margin-top: 2pt; }\n.alert { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2pt 10pt; border: 1px solid var(--rule); border-left: 3pt solid var(--c); border-radius: 0 5pt 5pt 0; padding: 4pt 9pt; margin: 0 0 8pt; }\n.alert.green { --c: var(--green); color: var(--ink); } .alert.amber { --c: var(--amber); color: var(--ink); } .alert.red { --c: var(--red); color: var(--ink); background: #fdf1f1; }\n.alert .lab { margin: 0; color: var(--ink); font-weight: 700; }\n.alert .tag { color: var(--c); }\n.alert p { grid-column: 1 / -1; margin: 0; font-size: 7.4pt; color: var(--muted); line-height: 1.4; }\n</style>", "fond": "<path d=\"M345.3,409.3L341.3,412.5L339.8,414.7L338.7,418.4L339.5,423.7L329.6,429.3L320.3,432.9L312.5,434.7L306.7,438.0L302.6,438.4L293.6,441.7L288.8,444.9L286.9,448.3L282.7,452.2L276.5,453.1L271.8,452.2L266.1,455.5L262.6,459.1L252.6,462.4L234.6,464.7L230.2,469.5L226.6,470.8L224.6,473.9L220.2,475.0L217.9,473.9L213.8,476.6L208.2,477.7L202.1,475.4L199.8,476.1L199.7,473.6L195.7,466.0L196.5,458.5L195.7,455.5L193.4,452.9L193.4,449.5L190.7,438.5L191.0,436.4L189.8,433.1L186.6,431.3L187.2,429.5L188.6,430.6L188.8,429.5L187.5,423.9L189.4,417.1L188.8,411.1L194.7,405.4L194.9,403.3L193.9,401.0L194.6,396.2L195.8,395.2L195.0,393.6L198.7,390.8L201.6,391.6L203.4,393.4L206.7,394.3L210.6,392.9L226.4,392.4L232.6,394.7L245.0,395.9L251.7,395.2L255.7,400.8L258.2,400.8L263.0,398.0L265.3,392.0L274.7,379.4L288.6,372.0L335.7,364.6L347.7,394.7L348.8,395.2L353.4,406.2L345.3,409.3ZM185.0,430.4L185.1,428.1L185.6,427.7L185.9,428.8L185.0,430.4ZM187.0,458.9L187.7,457.5L188.6,457.1L188.2,458.4L187.0,458.9ZM188.3,453.9L187.0,452.9L188.2,451.8L188.8,452.9L188.3,453.9ZM365.1,477.5L371.0,476.8L376.2,478.7L370.1,482.1L363.5,482.8L361.6,482.4L357.1,479.1L360.5,475.7L365.1,477.5Z\" fill=\"#ffffff\" stroke=\"#b9c3d0\" stroke-width=\".6\"/><path d=\"M544.0,18.1L533.0,11.0L530.6,11.5L524.2,7.8L520.2,3.9L503.7,-6.7L502.1,-12.9L497.6,-19.1L495.5,-24.8L544.0,-24.8L544.0,18.1Z\" fill=\"#ffffff\" stroke=\"#b9c3d0\" stroke-width=\".6\"/><path d=\"M405.8,248.3L406.2,258.7L401.0,263.0L399.5,260.9L400.0,259.3L398.7,258.9L396.8,260.7L396.3,267.4L397.0,269.9L396.